<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#3A6A3FE0" />
            <corners android:radius="8dp" />
            <stroke
                android:width="2dp"
                android:color="#9C72FF" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape>
            <solid android:color="#5A35269A" />
            <corners android:radius="6dp" />
            <stroke
                android:width="1dp"
                android:color="#69E8D3" />
        </shape>
    </item>
</layer-list>
