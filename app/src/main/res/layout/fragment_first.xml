<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_biology_screen"
    tools:context=".FirstFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topAppBar"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:background="#F2051427"
        android:paddingStart="18dp"
        android:paddingEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/screenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Biology Explorer"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/modelTitle" />

        <TextView
            android:id="@+id/modelTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#8FE7D4"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/modelAvailability"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="Bacteria Cell" />

        <TextView
            android:id="@+id/modelAvailability"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_status_ready"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="READY"
            android:textColor="#9AF5D9"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/learningModeTabs"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:background="#F2051427"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topAppBar">

        <TextView
            android:id="@+id/exploreTab"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_filter_chip_selected"
            android:contentDescription="Explore selected 3D model"
            android:gravity="center"
            android:text="Explore"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/learnTab"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:contentDescription="Learn about selected model"
            android:gravity="center"
            android:text="Learn"
            android:textColor="#98A8C2"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/quizTab"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:contentDescription="Take anatomy quiz"
            android:gravity="center"
            android:text="Quiz"
            android:textColor="#98A8C2"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/notesTab"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:contentDescription="Open notes and bookmarks"
            android:gravity="center"
            android:text="Notes"
            android:textColor="#98A8C2"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/learningModeTabs">

        <LinearLayout
            android:id="@+id/contentColumn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:id="@+id/workflowPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/viewerContainer"
                android:layout_width="match_parent"
                android:layout_height="500dp"
                android:background="@drawable/bg_surface_panel">

                <WebView
                    android:id="@+id/modelWebView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#00000000"
                    android:overScrollMode="never" />

                <LinearLayout
                    android:id="@+id/viewerStatusOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#EE031326"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/modelProgress"
                        style="?android:attr/progressBarStyleLarge"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:indeterminateTint="#55E7D0" />

                    <TextView
                        android:id="@+id/viewerStatusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:text="Preparing 3D model…"
                        android:textColor="#DCEAFF"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:id="@+id/viewerStatusActions"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/retryModelButton"
                            android:layout_width="104dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_filter_chip_selected"
                            android:gravity="center"
                            android:text="Retry"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/closeStatusButton"
                            android:layout_width="104dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_filter_chip"
                            android:gravity="center"
                            android:text="Close"
                            android:textColor="#DCEAFF"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/orientationIndicator"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_orientation_indicator"
                    android:gravity="center"
                    android:text="FRONT"
                    android:textColor="#DCEAFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:tooltipText="Current model orientation" />

                <LinearLayout
                    android:id="@+id/zoomControls"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_control_bar"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/zoomInButton"
                        style="@style/BiologyViewerControl"
                        android:contentDescription="Zoom in"
                        android:text="+"
                        android:tooltipText="Zoom in" />

                    <TextView
                        android:id="@+id/zoomLevel"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:text="100%"
                        android:textColor="#9FB3CF"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/zoomOutButton"
                        style="@style/BiologyViewerControl"
                        android:contentDescription="Zoom out"
                        android:text="−"
                        android:tooltipText="Zoom out" />
                </LinearLayout>

                <HorizontalScrollView
                    android:id="@+id/viewerControlContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="54dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_control_bar"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/viewerControls"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp">

                        <TextView
                            android:id="@+id/rotateLeftButton"
                            style="@style/BiologyViewerControl"
                            android:contentDescription="Rotate left"
                            android:text="↶"
                            android:tooltipText="Rotate left" />

                        <TextView
                            android:id="@+id/rotationButton"
                            style="@style/BiologyViewerControl"
                            android:contentDescription="Pause automatic rotation"
                            android:text="Ⅱ"
                            android:tooltipText="Pause automatic rotation" />

                        <TextView
                            android:id="@+id/rotateRightButton"
                            style="@style/BiologyViewerControl"
                            android:contentDescription="Rotate right"
                            android:text="↷"
                            android:tooltipText="Rotate right" />

                        <TextView
                            android:id="@+id/rotationSpeedButton"
                            style="@style/BiologyViewerControl"
                            android:contentDescription="Change rotation speed"
                            android:text="1×"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:tooltipText="Rotation speed" />

                        <TextView
                            android:id="@+id/cameraViewButton"
                            style="@style/BiologyViewerControl"
                            android:contentDescription="Change camera view"
                            android:text="FR"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:tooltipText="Camera view" />

                        <TextView
                            android:id="@+id/resetViewButton"
                            style="@style/BiologyViewerControl"
                            android:contentDescription="Reset view"
                            android:text="⌂"
                            android:tooltipText="Reset view" />

                        <TextView
                            android:id="@+id/fullScreenButton"
                            style="@style/BiologyViewerControl"
                            android:contentDescription="Open full screen"
                            android:text="⛶"
                            android:tooltipText="Open full screen" />
                    </LinearLayout>
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/fullScreenTopBar"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_gravity="top"
                    android:background="#E6031326"
                    android:elevation="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="10dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/fullScreenTitle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        tools:text="Bacteria Cell" />

                    <TextView
                        android:id="@+id/fullScreenClose"
                        style="@style/BiologyViewerControl"
                        android:contentDescription="Close full screen"
                        android:text="×"
                        android:textSize="30sp"
                        android:tooltipText="Close full screen" />
                </LinearLayout>

                <TextView
                    android:id="@+id/fullScreenHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="82dp"
                    android:background="@drawable/bg_control_bar"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="10dp"
                    android:text="Drag to rotate  •  Double-tap to focus  •  Tap to show controls"
                    android:textColor="#E4ECF8"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/interactionHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="Drag to rotate  •  Pinch to zoom  •  Tap a marker"
                android:textColor="#91A6C5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/modelSelectorHeader"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_surface_panel"
                android:drawableEnd="@drawable/ic_chevron_up"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="12dp"
                android:text="Explore models"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/modelDiscoveryPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/modelSearch"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_search_field"
                    android:drawableStart="@android:drawable/ic_menu_search"
                    android:drawablePadding="10dp"
                    android:hint="Search biology models"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#7F91AB"
                    android:textSize="14sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/filterStrip"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/recentModelsLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Recently viewed"
                    android:textColor="#DCE6F5"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <HorizontalScrollView
                    android:id="@+id/recentStripContainer"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginTop="6dp"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/recentStrip"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="All models"
                    android:textColor="#DCE6F5"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:id="@+id/modelStripContainer"
                    android:layout_width="match_parent"
                    android:layout_height="118dp"
                    android:layout_marginTop="6dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/modelStrip"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <TextView
                android:id="@+id/partsHeader"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_surface_panel"
                android:drawableEnd="@drawable/ic_chevron_up"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="12dp"
                android:text="Identify parts"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/partsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/infoPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_surface_panel"
                android:minHeight="128dp"
                android:padding="18dp">

                <TextView
                    android:id="@+id/featureNumber"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_number_badge"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/featureTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/featureNumber"
                    app:layout_constraintTop_toTopOf="@id/featureNumber"
                    tools:text="Nucleoid" />

                <TextView
                    android:id="@+id/featureDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="#C2CDE0"
                    android:textSize="15sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/featureNumber"
                    tools:text="The nucleoid contains the bacterium's genetic material." />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/fullScreenOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#010815"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/fullScreenViewerHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
