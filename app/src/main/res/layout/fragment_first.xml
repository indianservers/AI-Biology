<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_biology_screen"
    tools:context=".FirstFragment">

    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="24dp"
            android:paddingEnd="18dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Biology Explorer"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/modelType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Interactive 3D anatomy"
                android:textColor="#55E7D0"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/modelSelectorHeader"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_parts_panel"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Models  -  tap to collapse"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:id="@+id/modelStripContainer"
                android:layout_width="match_parent"
                android:layout_height="116dp"
                android:layout_marginTop="8dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/modelStrip"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/modelTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="#FFFFFF"
                android:textSize="27sp"
                android:textStyle="bold"
                tools:text="Bacteria Cell" />

            <FrameLayout
                android:id="@+id/viewerContainer"
                android:layout_width="match_parent"
                android:layout_height="440dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_parts_panel">

                <WebView
                    android:id="@+id/modelWebView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#00000000"
                    android:overScrollMode="never" />

                <ProgressBar
                    android:id="@+id/modelProgress"
                    style="?android:attr/progressBarStyleLarge"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="#55E7D0"
                    android:visibility="gone" />

                <HorizontalScrollView
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_control_rail"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/viewerControls"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp">

                        <TextView
                            android:id="@+id/rotateLeftButton"
                            style="@style/BiologyViewerControl"
                            android:contentDescription="Rotate left"
                            android:tooltipText="Rotate left"
                            android:text="↶" />

                        <TextView
                            android:id="@+id/rotationButton"
                            style="@style/BiologyViewerControl"
                            android:contentDescription="Pause automatic rotation"
                            android:tooltipText="Pause automatic rotation"
                            android:text="Ⅱ" />

                        <TextView
                            android:id="@+id/rotateRightButton"
                            style="@style/BiologyViewerControl"
                            android:contentDescription="Rotate right"
                            android:tooltipText="Rotate right"
                            android:text="↷" />

                        <TextView
                            android:id="@+id/zoomOutButton"
                            style="@style/BiologyViewerControl"
                            android:contentDescription="Zoom out"
                            android:tooltipText="Zoom out"
                            android:text="−" />

                        <TextView
                            android:id="@+id/zoomInButton"
                            style="@style/BiologyViewerControl"
                            android:contentDescription="Zoom in"
                            android:tooltipText="Zoom in"
                            android:text="+" />

                        <TextView
                            android:id="@+id/resetViewButton"
                            style="@style/BiologyViewerControl"
                            android:contentDescription="Reset view"
                            android:tooltipText="Reset view"
                            android:text="⌂" />

                        <TextView
                            android:id="@+id/fullScreenButton"
                            style="@style/BiologyViewerControl"
                            android:contentDescription="Open full screen"
                            android:tooltipText="Open full screen"
                            android:text="⛶" />
                    </LinearLayout>
                </HorizontalScrollView>
            </FrameLayout>

            <TextView
                android:id="@+id/interactionHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="8dp"
                android:text="Drag for 360° rotation  •  Pinch to zoom"
                android:textColor="#91A6C5"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/partsHeader"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_parts_panel"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Identify parts  -  tap to collapse"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/partsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/infoPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_info_panel"
                android:minHeight="128dp"
                android:padding="18dp">

                <TextView
                    android:id="@+id/featureNumber"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_number_badge"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/featureTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/featureNumber"
                    app:layout_constraintTop_toTopOf="@id/featureNumber"
                    tools:text="Nucleoid" />

                <TextView
                    android:id="@+id/featureDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="#C2CDE0"
                    android:textSize="15sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/featureNumber"
                    tools:text="The nucleoid contains the bacterium's genetic material." />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/fullScreenOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#010815"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/fullScreenViewerHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="top"
            android:background="#CC031326"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/fullScreenTitle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold"
                tools:text="Bacteria Cell" />

            <TextView
                android:id="@+id/fullScreenClose"
                style="@style/BiologyViewerControl"
                android:contentDescription="Close full screen"
                android:tooltipText="Close full screen"
                android:text="×"
                android:textSize="30sp" />
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
