<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_biology_screen"
    tools:context=".HomeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/homeTopBar"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:background="#F2051427"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/homeTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="AI Explorer STEM"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/homeSubtitle"
            app:layout_constraintEnd_toStartOf="@id/homeShareButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/homeSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Biology"
            android:textColor="#73E8C5"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/homeTitle" />

        <ImageButton
            android:id="@+id/homeShareButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/share_app"
            android:padding="12dp"
            android:src="@drawable/ic_share"
            android:tint="#73E8C5"
            android:tooltipText="@string/share_app"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/homeMenuButton"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/homeMenuButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/open_app_menu"
            android:padding="12dp"
            android:src="@drawable/ic_more_vert"
            android:tint="#D6EAF8"
            android:tooltipText="@string/open_app_menu"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/homeLibraryStatus"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/homeLibraryStatus"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_status_ready"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="ONLINE"
            android:textColor="#9AF5D9"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/homeScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/homeTopBar">

        <LinearLayout
            android:id="@+id/homeContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="24dp"
            android:paddingEnd="18dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:id="@+id/homeIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Explore Biology"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Choose a learning module"
                    android:textColor="#91A6C5"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/homeKnowledgeCheck"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_filter_chip_selected"
                    android:clickable="true"
                    android:contentDescription="Start biology knowledge check"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="Knowledge Check  •  20+ MCQs &amp; Match"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/homeModuleGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/exploreModelsModule"
                    android:layout_width="match_parent"
                    android:layout_height="116dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_home_module_selector"
                    android:clickable="true"
                    android:contentDescription="Explore 3D Models"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:contentDescription="Interactive 3D models"
                        android:scaleType="fitCenter"
                        android:src="@drawable/home_module_3d" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Explore 3D Models"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:maxLines="2"
                            android:text="Cells, organisms, organs and biological structures"
                            android:textColor="#91A6C5"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text=">"
                        android:textColor="#B9A8FF"
                        android:textSize="24sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/humanAnatomyModule"
                    android:layout_width="match_parent"
                    android:layout_height="116dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_home_module_selector"
                    android:clickable="true"
                    android:contentDescription="Human Anatomy"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:contentDescription="Human anatomy"
                        android:scaleType="fitCenter"
                        android:src="@drawable/home_module_anatomy" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Human Anatomy"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:maxLines="2"
                            android:text="Body systems, organs and anatomical relationships"
                            android:textColor="#91A6C5"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text=">"
                        android:textColor="#8EDCFF"
                        android:textSize="24sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/microscopeModule"
                    android:layout_width="match_parent"
                    android:layout_height="116dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_home_module_selector"
                    android:clickable="true"
                    android:contentDescription="Virtual Microscope"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:contentDescription="Virtual microscope"
                        android:scaleType="fitCenter"
                        android:src="@drawable/home_module_microscope" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Virtual Microscope"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:maxLines="2"
                            android:text="Zoomable tissue slides and identification challenges"
                            android:textColor="#91A6C5"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text=">"
                        android:textColor="#73E8C5"
                        android:textSize="24sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/infographicsModule"
                    android:layout_width="match_parent"
                    android:layout_height="116dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_home_module_selector"
                    android:clickable="true"
                    android:contentDescription="Biology Infographics"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:contentDescription="Infographic library"
                        android:scaleType="fitCenter"
                        android:src="@drawable/home_module_infographics" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Infographic Library"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:maxLines="2"
                            android:text="Visual guides for cells, systems and core concepts"
                            android:textColor="#91A6C5"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text=">"
                        android:textColor="#FFC28D"
                        android:textSize="24sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lessonsModule"
                    android:layout_width="match_parent"
                    android:layout_height="116dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_home_module_selector"
                    android:clickable="true"
                    android:contentDescription="Biology Lessons from Grade 6 to postgraduate"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_home_icon_library"
                        android:contentDescription="Lessons for Grade 6 through postgraduate"
                        android:gravity="center"
                        android:text="6–PG"
                        android:textColor="#73E8C5"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Lessons"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:maxLines="2"
                            android:text="Grade 6 to PG concepts explained in three simple phases"
                            android:textColor="#91A6C5"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text=">"
                        android:textColor="#73E8C5"
                        android:textSize="24sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/homeRecentSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Recently viewed"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/homeRecentList"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/homeLibraryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_surface_panel"
                android:clickable="true"
                android:contentDescription="Manage downloaded models in App Library"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="App Library"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/homeStorageSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Models download on demand"
                    android:textColor="#73E8C5"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/homeVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Version 1.01"
                android:textColor="#7187A5"
                android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
