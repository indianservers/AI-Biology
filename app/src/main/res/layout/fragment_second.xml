<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_biology_screen"
    tools:context=".SecondFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/libraryTopBar"
        android:layout_width="0dp"
        android:layout_height="82dp"
        android:background="#F2051427"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/libraryBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_filter_chip"
            android:contentDescription="Back to 3D explorer"
            android:gravity="center"
            android:text="&lt;"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/libraryTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Infographic Library"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/librarySubtitle"
            app:layout_constraintEnd_toStartOf="@id/libraryRefresh"
            app:layout_constraintStart_toEndOf="@id/libraryBack"
            app:layout_constraintTop_toTopOf="@id/libraryBack" />

        <TextView
            android:id="@+id/librarySubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Visual biology, available offline"
            android:textColor="#8FA6C5"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/libraryBack"
            app:layout_constraintEnd_toStartOf="@id/libraryRefresh"
            app:layout_constraintStart_toEndOf="@id/libraryBack"
            app:layout_constraintTop_toBottomOf="@id/libraryTitle" />

        <ImageButton
            android:id="@+id/libraryRefresh"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_filter_chip"
            android:contentDescription="Refresh infographic catalogue"
            android:padding="11dp"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <EditText
        android:id="@+id/infographicSearch"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_search_field"
        android:hint="Search topics, systems, or structures"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#748AA8"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/libraryTopBar" />

    <LinearLayout
        android:id="@+id/libraryFilters"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="9dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/infographicSearch">

        <TextView
            android:id="@+id/allInfographicsFilter"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_filter_chip_selected"
            android:gravity="center"
            android:text="All"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/savedInfographicsFilter"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:background="@drawable/bg_filter_chip"
            android:gravity="center"
            android:text="Saved offline"
            android:textColor="#9DAEC5"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/infographicCount"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:gravity="center_vertical"
            android:minWidth="68dp"
            android:textColor="#8FA6C5"
            android:textSize="12sp"
            tools:text="12 items" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/infographicGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/libraryFilters"
        tools:listitem="@layout/item_infographic_card" />

    <LinearLayout
        android:id="@+id/libraryEmptyState"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="@id/infographicGrid"
        app:layout_constraintEnd_toEndOf="@id/infographicGrid"
        app:layout_constraintStart_toStartOf="@id/infographicGrid"
        app:layout_constraintTop_toTopOf="@id/infographicGrid">

        <ProgressBar
            android:id="@+id/libraryLoading"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:indeterminateTint="#73E8C5" />

        <TextView
            android:id="@+id/libraryEmptyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Loading visual library"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/libraryEmptyMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="Checking the online catalogue and saved items."
            android:textColor="#8FA6C5"
            android:textSize="13sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
