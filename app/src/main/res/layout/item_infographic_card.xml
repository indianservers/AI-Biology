<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/infographicCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#0A1B31"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:strokeColor="#24486B"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_gravity="center"
            android:background="#071526"
            android:minHeight="128dp">

            <ImageView
                android:id="@+id/infographicThumbnail"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/infographicPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:gravity="center"
                android:text="INFO"
                android:textColor="#5D789A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/offlineBadge"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/bg_status_ready"
                android:gravity="center"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:text="OFFLINE"
                android:textColor="#8FF1D4"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/infographicCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#73E8C5"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="CELL BIOLOGY" />

            <TextView
                android:id="@+id/infographicTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:minHeight="44dp"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Inside the Animal Cell" />

            <TextView
                android:id="@+id/infographicSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:minHeight="38dp"
                android:textColor="#A9B9CF"
                android:textSize="12sp"
                tools:text="A visual guide to major organelles and their functions." />

            <TextView
                android:id="@+id/infographicAction"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_filter_chip"
                android:gravity="center"
                android:text="Save offline"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
