<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="152dp"
    android:layout_height="104dp"
    android:layout_margin="5dp"
    android:background="@drawable/bg_part_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <FrameLayout
        android:layout_width="54dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_thumbnail">

        <ImageView
            android:id="@+id/slideThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/slideMonogram"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#73E8C5"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="EP" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/slideCardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Simple epithelium" />

        <TextView
            android:id="@+id/slideCardMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#8FA6C5"
            android:textSize="10sp"
            tools:text="H&amp;E · 40x" />
    </LinearLayout>
</LinearLayout>
